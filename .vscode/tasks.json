{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "OMX: Build with camera dependencies",
      "type": "process",
      "command": "bash",
      "args": [
        "${workspaceFolder}/scripts/bootstrap.sh",
        "--vision"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "OMX: Offline tests",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": [
        "-m",
        "unittest",
        "discover",
        "-s",
        "tests",
        "-v"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "OMX: Run Gazebo and hand tracking",
      "type": "process",
      "command": "bash",
      "args": [
        "${workspaceFolder}/scripts/run_hand_control.sh"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}
