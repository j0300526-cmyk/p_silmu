<?xml version="1.0"?>
<!-- Adapted from ROBOTIS Humble; see THIRD_PARTY_NOTICES.md. -->
<robot name="open_manipulator_x">
  <group name="arm"><chain base_link="link1" tip_link="end_effector_link"/></group>
  <group name="gripper"><joint name="gripper_left_joint"/><joint name="gripper_right_joint"/></group>
  <group_state name="init" group="arm">
    <joint name="joint1" value="0"/><joint name="joint2" value="0"/>
    <joint name="joint3" value="0"/><joint name="joint4" value="0"/>
  </group_state>
  <group_state name="home" group="arm">
    <joint name="joint1" value="0"/><joint name="joint2" value="-1"/>
    <joint name="joint3" value="0.7"/><joint name="joint4" value="0.3"/>
  </group_state>
  <group_state name="open" group="gripper"><joint name="gripper_left_joint" value="0.019"/></group_state>
  <group_state name="close" group="gripper"><joint name="gripper_left_joint" value="-0.010"/></group_state>
  <end_effector name="gripper" parent_link="end_effector_link" group="gripper" parent_group="arm"/>
  <passive_joint name="gripper_right_joint"/>
  <disable_collisions link1="gripper_left_link" link2="gripper_right_link" reason="Never"/>
  <disable_collisions link1="gripper_left_link" link2="link4" reason="Never"/>
  <disable_collisions link1="gripper_left_link" link2="link5" reason="Adjacent"/>
  <disable_collisions link1="gripper_right_link" link2="link4" reason="Never"/>
  <disable_collisions link1="gripper_right_link" link2="link5" reason="Adjacent"/>
  <disable_collisions link1="link1" link2="link2" reason="Adjacent"/>
  <disable_collisions link1="link1" link2="link3" reason="Never"/>
  <disable_collisions link1="link2" link2="link3" reason="Adjacent"/>
  <disable_collisions link1="link3" link2="link4" reason="Adjacent"/>
  <disable_collisions link1="link4" link2="link5" reason="Adjacent"/>
</robot>
