<?xml version="1.0"?>
<robot name="open_manipulator_x" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:arg name="backend" default="gazebo_classic"/>
  <xacro:arg name="controllers_file" default="$(find omx_control)/config/controllers_sim.yaml"/>
  <xacro:arg name="initial_positions_file" default="$(find omx_description)/config/initial_positions.yaml"/>
  <xacro:property name="backend" value="$(arg backend)"/>
  <xacro:property name="initial_file" value="$(arg initial_positions_file)"/>
  <xacro:property name="initial" value="${xacro.load_yaml(initial_file)}"/>
  <xacro:include filename="$(find open_manipulator_x_description)/gazebo/materials.xacro"/>
  <xacro:include filename="$(find open_manipulator_x_description)/urdf/open_manipulator_x.urdf.xacro"/>
  <xacro:include filename="$(find open_manipulator_x_description)/gazebo/open_manipulator_x.gazebo.xacro"/>
  <xacro:open_manipulator_x prefix=""/>
  <xacro:open_manipulator_x_gazebo prefix=""/>
  <link name="world"/>
  <joint name="world_fixed" type="fixed">
    <parent link="world"/><child link="link1"/><origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>
  <ros2_control name="OpenManipulatorXSystem" type="system">
    <hardware>
      <xacro:if value="${backend == 'gazebo_classic'}">
        <plugin>gazebo_ros2_control/GazeboSystem</plugin>
      </xacro:if>
      <xacro:if value="${backend == 'fake'}">
        <plugin>mock_components/GenericSystem</plugin>
      </xacro:if>
    </hardware>
    <xacro:macro name="controlled_joint" params="name">
      <joint name="${name}">
        <command_interface name="position"/>
        <state_interface name="position"><param name="initial_value">${initial[name]}</param></state_interface>
        <state_interface name="velocity"><param name="initial_value">0.0</param></state_interface>
        <state_interface name="effort"><param name="initial_value">0.0</param></state_interface>
      </joint>
    </xacro:macro>
    <xacro:controlled_joint name="joint1"/>
    <xacro:controlled_joint name="joint2"/>
    <xacro:controlled_joint name="joint3"/>
    <xacro:controlled_joint name="joint4"/>
    <xacro:controlled_joint name="gripper_left_joint"/>
    <joint name="gripper_right_joint">
      <param name="mimic">gripper_left_joint</param><param name="multiplier">1</param>
      <command_interface name="position"/>
      <state_interface name="position"><param name="initial_value">${initial['gripper_left_joint']}</param></state_interface>
      <state_interface name="velocity"><param name="initial_value">0.0</param></state_interface>
      <state_interface name="effort"><param name="initial_value">0.0</param></state_interface>
    </joint>
  </ros2_control>
  <xacro:if value="${backend == 'gazebo_classic'}">
    <gazebo>
      <plugin name="gazebo_ros2_control" filename="libgazebo_ros2_control.so">
        <robot_param>robot_description</robot_param>
        <robot_param_node>robot_state_publisher</robot_param_node>
        <parameters>$(arg controllers_file)</parameters>
      </plugin>
    </gazebo>
  </xacro:if>
</robot>
