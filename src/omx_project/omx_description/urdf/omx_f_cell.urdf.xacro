<?xml version="1.0"?>
<robot name="omx_f" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:arg name="backend" default="gazebo_classic"/>
  <xacro:arg name="controllers_file" default="$(find omx_control)/config/omx_f/controllers_sim.yaml"/>
  <xacro:property name="backend" value="$(arg backend)"/>
  <xacro:property name="initial" value="${xacro.load_yaml('$(find omx_description)/config/omx_f_initial_positions.yaml')}"/>
  <xacro:property name="joint_ranges" value="${xacro.load_yaml('$(find omx_description)/config/omx_f_joint_ranges.yaml')}"/>
  <xacro:include filename="$(find omx_description)/urdf/omx_f_arm.urdf.xacro"/>
  <xacro:omx_f prefix=""/>
  <link name="world"/>
  <joint name="world_fixed" type="fixed">
    <parent link="world"/><child link="link0"/><origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>
  <joint name="end_effector_joint" type="fixed">
    <parent link="link5"/><child link="end_effector_link"/>
    <origin xyz="0.09193 -0.0016 0" rpy="0 0 0"/>
  </joint>
  <link name="end_effector_link">
    <visual><geometry><box size="0.01 0.01 0.01"/></geometry>
      <material name="tcp_red"><color rgba="1 0 0 1"/></material>
    </visual>
  </link>
  <ros2_control name="OMXFSimulationSystem" type="system">
    <hardware>
      <xacro:if value="${backend == 'gazebo_classic'}"><plugin>gazebo_ros2_control/GazeboSystem</plugin></xacro:if>
      <xacro:if value="${backend == 'fake'}"><plugin>mock_components/GenericSystem</plugin></xacro:if>
    </hardware>
    <xacro:macro name="controlled_joint" params="name">
      <joint name="${name}">
        <command_interface name="position"/>
        <state_interface name="position"><param name="initial_value">${initial[name]}</param></state_interface>
        <state_interface name="velocity"><param name="initial_value">0.0</param></state_interface>
        <state_interface name="effort"><param name="initial_value">0.0</param></state_interface>
      </joint>
    </xacro:macro>
    <xacro:controlled_joint name="joint1"/><xacro:controlled_joint name="joint2"/>
    <xacro:controlled_joint name="joint3"/><xacro:controlled_joint name="joint4"/>
    <xacro:controlled_joint name="joint5"/><xacro:controlled_joint name="gripper_joint_1"/>
    <joint name="gripper_joint_2">
      <param name="mimic">gripper_joint_1</param><param name="multiplier">-1</param>
      <command_interface name="position"/>
      <state_interface name="position"><param name="initial_value">${-initial['gripper_joint_1']}</param></state_interface>
      <state_interface name="velocity"><param name="initial_value">0.0</param></state_interface>
      <state_interface name="effort"><param name="initial_value">0.0</param></state_interface>
    </joint>
  </ros2_control>
  <xacro:if value="${backend == 'gazebo_classic'}">
    <gazebo>
      <plugin name="gazebo_ros2_control" filename="libgazebo_ros2_control.so">
        <robot_param>robot_description</robot_param><robot_param_node>robot_state_publisher</robot_param_node>
        <parameters>$(arg controllers_file)</parameters>
      </plugin>
    </gazebo>
  </xacro:if>
</robot>
