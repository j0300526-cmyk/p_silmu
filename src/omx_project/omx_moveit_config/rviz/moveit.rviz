Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Global Options:
    Fixed Frame: world
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
    - Class: moveit_rviz_plugin/MotionPlanning
      Name: MotionPlanning
      Enabled: true
      Robot Description: robot_description
      Planning Scene Topic: /monitored_planning_scene
      Planning Request:
        Planning Group: arm
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 1.0
      Pitch: 0.5
      Yaw: 0.7
      Focal Point: {X: 0.15, Y: 0.0, Z: 0.15}
Window Geometry:
  Width: 1200
  Height: 800
